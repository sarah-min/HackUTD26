    "generate": "spacetime generate --lang typescript --out-dir ../packages/stdb-bindings/src --module-path ."
  },
  "dependencies": {
    "spacetimedb": "2.13.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
