# Worker image (built by compose.gpu.yaml from the repo root). Needs the root pnpm workspace
# (package.json + pnpm-workspace.yaml + pnpm-lock.yaml, Part 1).
FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY . .
RUN pnpm install --frozen-lockfile --filter @hack/worker...
ENV NODE_ENV=production
WORKDIR /app/apps/worker
CMD ["pnpm", "start"]
