# Copy to apps/worker/brev/.env on the Brev instance. Never commit the real file.
# SpacetimeDB: build against dev; switch STDB_MODULE to aftermath-hackutd for the demo only.
STDB_URI=https://maincloud.spacetimedb.com
STDB_MODULE=aftermath-hackutd-dev
# SECRET: the worker token registered by Sidd as "worker" on both databases (pnpm --filter @hack/worker identity).
STDB_SERVICE_TOKEN=replace-me
# SECRET: shared key between the worker and the two vLLM servers (openssl rand -hex 32).
NEMOTRON_API_KEY=replace-me
# Optional: Hugging Face token (weights are public; a token avoids anonymous download rate limits).
HF_TOKEN=
# Optional tuning for one 80 GB GPU.
VL_GPU_FRACTION=0.30
AGENT_GPU_FRACTION=0.60
WORKER_CONCURRENCY=1
VL_CONCURRENCY=2
# VLLM_IMAGE=vllm/vllm-openai:v0.28.0
