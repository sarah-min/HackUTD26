# Copy to .env next to compose.gpu.yaml on the Vultr GPU instance. Never commit the real file.
# Shared secret the worker sends as "Authorization: Bearer ..." (generate: openssl rand -hex 32). SECRET
NEMOTRON_API_KEY=replace-me
# Address the two servers listen on. Use the GPU instance's Vultr VPC (private) IP so only the worker VM can reach it.
BIND_ADDR=127.0.0.1
# Optional: Hugging Face token (weights are public; a token avoids anonymous download rate limits).
HF_TOKEN=
# Optional tuning for one 80 GB GPU. Lower both on a smaller card, or move one model to a second GPU instance.
VL_GPU_FRACTION=0.30
AGENT_GPU_FRACTION=0.60
# VLLM_IMAGE=vllm/vllm-openai:v0.28.0
