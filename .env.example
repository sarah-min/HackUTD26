# Copy to .env.local (dev) or /opt/app/.env (VM). Placeholders only; never commit real values.
# Owner: Part 4. Ask Part 4 to add new variable names. See CONTRACTS.md §10.

# --- App / web ---
APP_BASE_URL=http://localhost:3000
APP_DOMAIN=example.tld                     # used by Caddy on the VM

# --- SpacetimeDB (public values: safe for the browser) ---
# https:// is correct; the SDK upgrades to websocket. Defaults in apps/web/lib/stdb/config.ts match these.
NEXT_PUBLIC_STDB_URI=https://maincloud.spacetimedb.com
NEXT_PUBLIC_STDB_MODULE=aftermath-hackutd-dev

# --- SpacetimeDB (server side: worker, web API routes, scripts) ---
STDB_URI=https://maincloud.spacetimedb.com
STDB_MODULE=aftermath-hackutd-dev
STDB_SERVICE_TOKEN=replace-me               # SECRET: worker identity token
STDB_WEB_TOKEN=replace-me                   # SECRET: web-server identity for presign/media (P4)
DEV_WORKER_TOKEN=replace-me                 # SECRET: dev-only fake worker (never use on prod DB)

# --- NVIDIA Nemotron (worker) ---
NVIDIA_API_KEY=replace-me                   # SECRET
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_VL_MODEL=nvidia/nemotron-nano-12b-v2-vl       # VERIFY on build.nvidia.com
NEMOTRON_AGENT_MODEL=replace-me             # VERIFY: Nemotron model with tool calling

# --- Vultr Object Storage, S3-compatible (web and worker) ---
S3_ENDPOINT=https://region.vultrobjects.com            # VERIFY region hostname
S3_REGION=us-east-1                         # VERIFY: value the S3 SDK expects for Vultr
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=replace-me                 # SECRET
S3_SECRET_ACCESS_KEY=replace-me             # SECRET

# --- Geocoding (web: /api/geocode) ---
NOMINATIM_USER_AGENT=project-aftermath-hackutd   # generic app name; no personal email
CENSUS_GEOCODER_BENCHMARK=Public_AR_Current      # VERIFY current benchmark name

# --- Identity verification (worker + module rate limit) ---
IDV_MAX_ATTEMPTS_PER_HOUR=3

# --- Worker tuning ---
WORKER_CONCURRENCY=2
VL_CONCURRENCY=4
USE_FIXTURES=false                          # true = labeled fixture model output (dev only)
