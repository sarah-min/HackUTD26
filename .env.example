# Copy to .env.local (dev) or /opt/app/.env (VM). Placeholders only; never commit real values.
# Owner: Part 4. Ask Part 4 to add new variable names. See CONTRACTS.md §10 and status/part2.md handoff.

# --- App / web ---
APP_BASE_URL=http://localhost:3000
APP_DOMAIN=example.tld                     # used by Caddy on the VM

# --- SpacetimeDB (public values: safe for the browser) ---
# https:// is correct; the SDK upgrades to a websocket. Use -dev for build/test; prod only for the demo.
NEXT_PUBLIC_STDB_URI=https://maincloud.spacetimedb.com
NEXT_PUBLIC_STDB_MODULE=aftermath-hackutd-dev

# --- SpacetimeDB (server side: worker, web routes, scripts) ---
STDB_URI=https://maincloud.spacetimedb.com
STDB_MODULE=aftermath-hackutd-dev
STDB_SERVICE_TOKEN=replace-me               # SECRET: P3 worker identity token (never NEXT_PUBLIC_*)
STDB_WEB_TOKEN=replace-me                   # SECRET: P4 Next.js server identity for web_* auth views
DEV_WORKER_TOKEN=replace-me                 # SECRET: P2 fake-worker only; never production

# --- NVIDIA Nemotron (worker) ---
NVIDIA_API_KEY=replace-me                   # SECRET
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_VL_MODEL=nvidia/nemotron-nano-12b-v2-vl       # VERIFY on build.nvidia.com
NEMOTRON_AGENT_MODEL=replace-me             # VERIFY: Nemotron model with tool calling

# --- Vultr Object Storage, S3-compatible (web and worker) ---
# Object Storage is NOT in Dallas. Prefer Chicago chi3 (near DFW VM) or Atlanta atl1.
STORAGE_DRIVER=                             # set to "memory" for local tests without a bucket
S3_ENDPOINT=https://chi3.vultrobjects.com              # VERIFY against your subscription
S3_REGION=us-east-1                         # Vultr ignores region; SDKs still want a string
S3_BUCKET=aftermath-media
S3_ACCESS_KEY_ID=replace-me                 # SECRET — Object Storage → Access Keys
S3_SECRET_ACCESS_KEY=replace-me             # SECRET

# Dev-only JSON for upload/media auth before live web_* subscriptions (never production)
# WEB_AUTH_FIXTURE_JSON=

# --- Geocoding (web: /api/geocode) ---
NOMINATIM_USER_AGENT=project-aftermath-hackutd   # generic app name; no personal email
CENSUS_GEOCODER_BENCHMARK=Public_AR_Current      # VERIFY current benchmark name

# --- Identity verification (worker + module rate limit) ---
IDV_MAX_ATTEMPTS_PER_HOUR=3

# --- Worker tuning ---
WORKER_CONCURRENCY=2
VL_CONCURRENCY=4
USE_FIXTURES=false                          # true = labeled fixture model output (dev only)
