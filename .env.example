# Copy to .env.local (dev) or /opt/app/.env (VM). Placeholders only; never commit real values.
# Owner: Part 4. Ask Part 4 to add new variable names. See CONTRACTS.md §10.

# --- App / web ---
APP_BASE_URL=http://localhost:3000
APP_DOMAIN=example.tld                     # used by Caddy on the VM

# --- SpacetimeDB (public values: safe for the browser) ---
NEXT_PUBLIC_STDB_URI=wss://maincloud.spacetimedb.com   # VERIFY
NEXT_PUBLIC_STDB_MODULE=your-module-name

# --- SpacetimeDB (server side: worker and scripts) ---
STDB_URI=https://maincloud.spacetimedb.com
STDB_MODULE=aftermath-hackutd-dev           # aftermath-hackutd for the demo only
STDB_SERVICE_TOKEN=replace-me               # SECRET: worker identity token

# --- Nemotron, self-hosted with vLLM on the NVIDIA Brev GPU instance (worker) ---
# On Brev the worker runs in the same compose project, so these point at the compose services
# (apps/worker/brev/compose.gpu.yaml). There is no hosted NVIDIA API fallback.
NEMOTRON_VL_BASE_URL=http://nemotron-vl:8001/v1
NEMOTRON_AGENT_BASE_URL=http://nemotron-agent:8002/v1
NEMOTRON_API_KEY=replace-me                 # SECRET: shared with the vLLM servers
NEMOTRON_VL_MODEL=nvidia/NVIDIA-Nemotron-Nano-12B-v2-VL-FP8
NEMOTRON_AGENT_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8

# File storage and address lookup run inside the SpacetimeDB module (blob tables, read_blob, geocode_* procedures):
# no S3 bucket, no storage keys, no geocoding env.

# --- Identity verification (worker + module rate limit) ---
IDV_MAX_ATTEMPTS_PER_HOUR=3

# --- Worker tuning ---
WORKER_CONCURRENCY=2
VL_CONCURRENCY=4
USE_FIXTURES=false                          # true = labeled fixture model output (dev only)
